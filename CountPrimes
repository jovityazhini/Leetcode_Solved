import java.util.*;
class Solution {
    public int countPrimes(int n) {
        int i;
        boolean[] isPrime = new boolean[n];
        Arrays.fill(isPrime, true);
        if (n <= 2) {
            return 0;
        }
        isPrime[0] = false;
        isPrime[1] = false;
        for (i = 2; i * i < n; i++) {
            if (isPrime[i]) {
                for (int j = i * i; j < n; j += i) {
                    isPrime[j] = false;
                }
            }
        }
        int count = 0;
        for (int i = 2; i < n; i++) {
            if (isPrime[i]) {
                count++;
            }
        }
        return count;
    }
}
